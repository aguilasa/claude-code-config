{
  "mcpServers": {
    "solidcraft": {
      "type": "stdio",
      "command": "solidcraft-cli",
      "args": ["mcp", "--headless", "--allow-path", "${SOLIDCRAFT_ALLOW_PATH}"]
    },
    "solidcraft-live": {
      "type": "stdio",
      "command": "solidcraft-cli",
      "args": ["mcp", "--connect", "127.0.0.1:7878", "--allow-path", "${SOLIDCRAFT_ALLOW_PATH}"]
    },
    "blender-mcp": {
      "type": "stdio",
      "command": "uvx",
      "args": ["blender-mcp"]
    }
  }
}
